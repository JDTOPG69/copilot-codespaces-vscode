body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  background-color: #f8f9fa;
  color: #333;
  scroll-behavior: smooth;
}

.hero {
  background: url('https://source.unsplash.com/1600x900/?nature,abstract') center/cover no-repeat;
  height: 100vh;
  position: relative;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.overlay {
  background: rgba(0, 0, 0, 0.6);
  padding: 40px;
  border-radius: 10px;
}

.overlay h1 {
  font-size: 3em;
  margin-bottom: 0.2em;
}

.overlay .btn {
  margin-top: 20px;
  display: inline-block;
  padding: 10px 20px;
  color: white;
  background-color: #00b894;
  border-radius: 5px;
  text-decoration: none;
  font-weight: 600;
}

.navbar {
  background: #2d3436;
  padding: 10px 0;
  text-align: center;
}

.navbar a {
  color: white;
  margin: 0 20px;
  text-decoration: none;
  font-weight: 600;
}

.navbar a:hover {
  text-decoration: underline;
}

main {
  padding: 40px 20px;
  max-width: 900px;
  margin: auto;
}

section {
  margin-bottom: 60px;
}

.project-card {
  background: white;
  border-left: 5px solid #00b894;
  padding: 20px;
  margin: 15px 0;
  border-radius: 5px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.05);
}

footer {
  text-align: center;
  padding: 20px;
  background-color: #2d3436;
  color: white;
}
